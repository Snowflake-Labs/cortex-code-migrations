<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPIKE 1 — does the AI-first producer chain run OUTSIDE the xUnit/MSTest host?

    Deliberately lives OUTSIDE the engine repo so that neither the repo-root
    Directory.Build.props, nor Parsers/Directory.Build.targets, nor the AMG package can
    participate. That matters for two reasons:
      1. It makes the dependency question honest — nothing is inherited implicitly.
      2. Importing the amg package would drag in GenerateAstMachinery, which has no
         Inputs/Outputs and regenerates 42 ASTs (~45-60 min). See tickets/ENG-016.

    References are DLLs the engine build already produced, resolved by path from the test
    project's own output directory, because that directory is by construction the closed set
    of assemblies the chain needs at runtime. No project references, so no rebuild.
  -->

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AiFirst.Producer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>aifirst-migrate</AssemblyName>
    <RootNamespace>AiFirst</RootNamespace>
    <!-- The producer files were written for a test project and carry its analyzer settings.
         Treat warnings as warnings here: the question is whether it RUNS, not whether it is
         lint-clean in a new home. Any warning that matters is reported in the finding. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);SA0001;SA1600;SA1633;CS1591</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ReferencePath compiles but does NOT populate deps.json, and the .NET host resolves
         assemblies from deps.json rather than from the directory. Net effect on the first run:
         a clean build, 257 assemblies staged beside the exe, and a runtime
         FileNotFoundException for an assembly sitting right there. Suppressing the dependency
         file makes the host fall back to probing the app directory. Worth knowing for the real
         extraction: a project with proper ProjectReferences will not hit this. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- The engine comes from the same NuGet packages, at the same version, as the SQL code
       processor: EnginePackageVersion is read from the Mobilize.Snow.CodeProcessor reference in
       Snowflake.SnowConvertDesktop.Sql.csproj, the line the migrations-snowconvert bump bot
       rewrites. -p:EnginePackageVersion=<v> tries another release.

       Developer override: AIFIRST_ENGINE_BIN (or -p:EngineBin) names a local engine build output
       instead, referenced by path as before. Release builds never set it. -->
  <PropertyGroup>
    <EngineBin Condition="'$(EngineBin)' == ''">$(AIFIRST_ENGINE_BIN)</EngineBin>
    <EngineBin Condition="'$(EngineBin)' != ''">$([MSBuild]::EnsureTrailingSlash('$(EngineBin)'))</EngineBin>
    <UseEnginePackages Condition="'$(EngineBin)' == ''">true</UseEnginePackages>
    <_SqlProcessorCsproj>$(MSBuildThisFileDirectory)../../../../../../../../Snowflake.SnowConvertDesktop/Snowflake.SnowConvertDesktop.Sql/Snowflake.SnowConvertDesktop.Sql.csproj</_SqlProcessorCsproj>
    <EnginePackageVersion Condition="'$(EnginePackageVersion)' == '' and Exists('$(_SqlProcessorCsproj)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_SqlProcessorCsproj)')), 'Include="Mobilize\.Snow\.CodeProcessor" Version="([^"]+)"').Groups[1].Value)</EnginePackageVersion>
    <RestoreConfigFile Condition="'$(UseEnginePackages)' == 'true' and '$(RestoreConfigFile)' == ''">$(MSBuildThisFileDirectory)../../../../../../../../Snowflake.SnowConvertDesktop/nuget.config</RestoreConfigFile>
  </PropertyGroup>

  <Target Name="ValidateEngineVersion" BeforeTargets="CollectPackageReferences" Condition="'$(UseEnginePackages)' == 'true'">
    <Error Condition="'$(EnginePackageVersion)' == ''"
           Text="No engine version: Mobilize.Snow.CodeProcessor not found in $(_SqlProcessorCsproj). Pass -p:EnginePackageVersion=... or set AIFIRST_ENGINE_BIN." />
  </Target>

  <!-- The same four engine packages Snowflake.SnowConvertDesktop.Sql references. -->
  <ItemGroup Condition="'$(UseEnginePackages)' == 'true'">
    <PackageReference Include="Artinsoft.Common.CoreAST" Version="$(EnginePackageVersion)" />
    <PackageReference Include="Mobilize.Common.Store.SqliteStorage" Version="$(EnginePackageVersion)" />
    <PackageReference Include="Mobilize.Snow.CodeProcessor" Version="207.1.0" />
    <PackageReference Include="Mobilize.Snow.CodeProcessor.Content" Version="207.1.0" />
  </ItemGroup>

  <Target Name="ValidateEngineBin" BeforeTargets="AddEngineReferences" Condition="'$(UseEnginePackages)' != 'true'">
    <Error Condition="!Exists('$(EngineBin)')"
           Text="AIFIRST_ENGINE_BIN/EngineBin does not exist: $(EngineBin)" />
  </Target>

  <!-- Override only: reference every assembly in that directory EXCEPT the test host and the test
       project itself. Injected as ReferencePath rather than Reference: a `Reference` built from an
       item transform loses the per-item HintPath and resolves to nothing (128 CS0246). -->
  <PropertyGroup>
    <_ExcludeDlls>$(EngineBin)UnitTests.dll;$(EngineBin)Moq.dll;$(EngineBin)Castle.Core.dll;$(EngineBin)Microsoft.VisualStudio.TestPlatform*.dll;$(EngineBin)Microsoft.TestPlatform*.dll;$(EngineBin)MSTest*.dll;$(EngineBin)testhost.dll</_ExcludeDlls>
  </PropertyGroup>

  <Target Name="AddEngineReferences" BeforeTargets="ResolveReferences" Condition="'$(UseEnginePackages)' != 'true'">
    <ItemGroup>
      <ReferencePath Include="$(EngineBin)*.dll" Exclude="$(_ExcludeDlls)" />
    </ItemGroup>
    <Message Importance="high" Text="spike: referencing @(ReferencePath->Count()) engine assemblies (test host excluded)" />
  </Target>

  <!-- ReferencePath bypasses copy-local, so the runtime closure has to be staged explicitly. -->
  <Target Name="StageEngineRuntime" AfterTargets="Build" Condition="'$(UseEnginePackages)' != 'true'">
    <ItemGroup>
      <_Runtime Include="$(EngineBin)*.dll" Exclude="$(_ExcludeDlls);$(EngineBin)aifirst-migrate.dll;$(EngineBin)aifirst-migrate.pdb" />
      <!-- Data files read from disk at runtime, not references. EwiModelReader resolves
           IssueResources.json relative to its OWN assembly location, so it must sit beside
           the staged DLLs or every EWI lookup silently returns nothing. -->
      <_Runtime Include="$(EngineBin)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_Runtime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="spike: staged @(_Runtime->Count()) runtime assemblies into $(OutDir)" />
  </Target>

  <!-- NATIVE assets, which the managed staging above cannot cover.
       MEASURED: ObjectReferenceCalculator is SQLite-backed, and the first run with reports wired in
       failed with `TypeInitializationException: The type initializer for
       'Microsoft.Data.Sqlite.SqliteConnection' threw an exception` — SQLitePCLRaw could not load
       `libe_sqlite3`. The engine bin DOES ship it, under runtimes/<rid>/native/, but RID-specific
       native asset resolution is a deps.json feature and GenerateDependencyFile is false above (see
       the note there). Without deps.json the host only probes beside the executable, so the native
       library has to be copied flat. Everything else about the reports worked before this — the
       lineage report was the only one absent, which is precisely the shape that would have read as
       "lineage is not drivable" if the exception had not been printed.

       A RID-specific `dotnet publish` of EngineBin (rather than a plain `dotnet build`) flattens
       these same files to the publish root instead of nesting them under runtimes/<rid>/native/,
       so flat .dylib/.so files are globbed too (libe_sqlite3, libscai_state). Flat Windows
       natives are .dll and StageEngineRuntime already copies them. -->
  <Target Name="StageNativeRuntime" AfterTargets="Build">
    <ItemGroup Condition="'$(UseEnginePackages)' != 'true'">
      <_Native Include="$(EngineBin)runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/*" />
      <_Native Include="$(EngineBin)*.dylib;$(EngineBin)*.so" />
    </ItemGroup>
    <!-- Package build: copy-local puts the package natives under $(OutDir)runtimes/<rid>/native/. -->
    <ItemGroup Condition="'$(UseEnginePackages)' == 'true'">
      <_Native Include="$(OutDir)runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Native)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="spike: staged @(_Native->Count()) native asset(s) for $(NETCoreSdkPortableRuntimeIdentifier)" />
  </Target>

</Project>
