{
  "name": "snowflake-migration",
  "version": "2.47.0",
  "description": "Snowflake AIM for Data Warehouses \u2014 end-to-end database migration to Snowflake: assessment, conversion, validation, and deployment",
  "author": {
    "name": "db-eng-migrations"
  },
  "skills": [
    "skills/migration"
  ],
  "mcpServers": {
    "mcp": {
      "type": "stdio",
      "command": "scai",
      "args": [
        "mcp",
        "run"
      ],
      "env": {
        "AIM_AUTONOMOUS": "${AIM_AUTONOMOUS:-}",
        "CUSTOM_SNOWCONVERT_COMMON_SCHEMA": "${CUSTOM_SNOWCONVERT_COMMON_SCHEMA:-}",
        "CUSTOM_SNOWCONVERT_DATABASE": "${CUSTOM_SNOWCONVERT_DATABASE:-}",
        "CUSTOM_SNOWCONVERT_DATA_MIGRATION_SCHEMA": "${CUSTOM_SNOWCONVERT_DATA_MIGRATION_SCHEMA:-}",
        "CUSTOM_SNOWCONVERT_DATA_VALIDATION_SCHEMA": "${CUSTOM_SNOWCONVERT_DATA_VALIDATION_SCHEMA:-}",
        "CUSTOM_SNOWCONVERT_TEMP_SCHEMA": "${CUSTOM_SNOWCONVERT_TEMP_SCHEMA:-}",
        "CUSTOM_SNOWFLAKE_DATABASE_FOR_METADATA": "${CUSTOM_SNOWFLAKE_DATABASE_FOR_METADATA:-}",
        "CUSTOM_SNOWFLAKE_SCHEMA_FOR_COMMON_METADATA": "${CUSTOM_SNOWFLAKE_SCHEMA_FOR_COMMON_METADATA:-}",
        "CUSTOM_SNOWFLAKE_SCHEMA_FOR_DATA_MIGRATION_METADATA": "${CUSTOM_SNOWFLAKE_SCHEMA_FOR_DATA_MIGRATION_METADATA:-}",
        "CUSTOM_SNOWFLAKE_SCHEMA_FOR_DATA_VALIDATION_METADATA": "${CUSTOM_SNOWFLAKE_SCHEMA_FOR_DATA_VALIDATION_METADATA:-}",
        "CUSTOM_SNOWFLAKE_SCHEMA_FOR_TEMP_METADATA": "${CUSTOM_SNOWFLAKE_SCHEMA_FOR_TEMP_METADATA:-}",
        "MIGRATION_MCP_SERVER_BIN": "${MIGRATION_MCP_SERVER_BIN:-}",
        "SCAI_CALLER": "${SCAI_CALLER:-}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.cmd",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd session-context",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd stamp-agent-id",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd agent-ledger",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd deny-agent-output-wait",
            "type": "command"
          }
        ],
        "matcher": "agent_output"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd deny-unclaimed-destructive-sql",
            "type": "command"
          }
        ],
        "matcher": "^(mcp__mcp__)?(query_source|sql_execute|snowflake_sql_execute|[Bb]ash|[Ss]hell)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd agent-ledger",
            "type": "command"
          }
        ],
        "matcher": "^([Tt]ask|[Aa]gent[_-]?[Oo]utput|[Kk]ill[_-]?[Aa]gent|[Aa]gent[_-]?[Kk]ill)$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd agent-ledger",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd agent-ledger",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp-hook.cmd agent-ledger",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "buildChannel": "preview"
}
